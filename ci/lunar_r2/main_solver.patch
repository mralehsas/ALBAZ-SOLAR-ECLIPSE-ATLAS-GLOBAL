+    """Resolve the directory that owns bundled runtime assets.
+
+    Standalone Windows builds must load DE440/IERS/cities next to the actual
+    executable.  Probe concrete candidate directories instead of trusting a
+    single packager-specific attribute, then fall back to the source tree.
+    """
+    candidates: list[Path] = []
+    if "__compiled__" in globals() or getattr(sys, "frozen", False):
+        candidates.append(Path(sys.executable).resolve().parent)
+    if hasattr(sys, "_MEIPASS"):
+        candidates.append(Path(getattr(sys, "_MEIPASS")).resolve())
+    candidates.append(Path(__file__).resolve().parent)
+
+    seen: set[Path] = set()
+    for root in candidates:
+        if root in seen:
+            continue
+        seen.add(root)
+        if (root / "data" / "de440.bsp").is_file():
+            return root
+    return candidates[0]
 
 
