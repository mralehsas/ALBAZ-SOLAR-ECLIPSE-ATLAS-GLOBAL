diff --git a/tests/test_lunar_visibility.py b/tests/test_lunar_visibility.py
index 86072ab..0e2193f 100644
--- a/tests/test_lunar_visibility.py
+++ b/tests/test_lunar_visibility.py
@@ -47,3 +47,17 @@ def test_visibility_grid_keeps_antimeridian_endpoints_distinct_and_normalized(se
     assert -180.0 in longs
     assert 180.0 in longs
     assert all(-180.0 <= p.longitude_deg <= 180.0 for p in points)
+
+
+def test_2026_greatest_moon_subpoint_agrees_with_nasa_rounded_zenith_location():
+    from lunar_core.topocentric import moon_geocentric_subpoint_deg
+    eph = DE440Ephemeris(Path('data/de440.bsp'))
+    solver = LunarEclipseSolver(eph)
+    event = solver.events_for_year(2026)[0]
+    lat, lon = moon_geocentric_subpoint_deg(
+        eph, event.greatest_tdb_jd, event.greatest_ut1_jd
+    )
+    assert lat == pytest.approx(6.0, abs=0.75)
+    # NASA lists 171 W; compare wrapped longitude.
+    dlon = ((lon - (-171.0) + 180.0) % 360.0) - 180.0
+    assert abs(dlon) < 0.75
