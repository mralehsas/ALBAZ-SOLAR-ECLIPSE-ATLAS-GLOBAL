+++ b/BUILD_FINAL_EXE_AND_OPEN.cmd
@@ -0,0 +1,51 @@
+@echo off
+setlocal EnableExtensions
+chcp 65001 >nul
+cd /d "%~dp0"
+title ALBAZ LUNAR ECLIPSE ATLAS - BUILD FINAL EXE AND OPEN
+
+set "APPNAME=ALBAZ_LUNAR_ECLIPSE_ATLAS_9_6_3_TESLA_FINAL"
+set "EXENAME=ALBAZ_LUNAR_ECLIPSE_ATLAS_9_6_3_TESLA_FINAL.exe"
+set "EXE=%CD%\FINAL_WINDOWS_LUNAR\%APPNAME%\%EXENAME%"
+
+echo ============================================================
+echo  ALBAZ LUNAR ECLIPSE ATLAS v9.6.3 TESLA FINAL
+echo  BUILD FINAL WINDOWS EXE AND OPEN
+echo ============================================================
+
+if exist "%EXE%" (
+  echo [OK] Existing verified EXE found.
+  echo Launching: %EXE%
+  start "" "%EXE%"
+  exit /b 0
+)
+
+echo No built EXE exists yet.
+echo Starting the full verified Windows builder...
+echo This same window will remain open if a build step fails.
+echo.
+call START_BUILD_LUNAR_9_6_3_FINAL_EXE.cmd
+set "RC=%ERRORLEVEL%"
+if not "%RC%"=="0" (
+  echo.
+  echo ============================================================
+  echo [BUILD FAILED] Exit code: %RC%
+  echo The error is shown above. Take a screenshot and send it here.
+  echo ============================================================
+  pause
+  exit /b %RC%
+)
+
+if not exist "%EXE%" (
+  echo.
+  echo [ERROR] Builder returned success but the final EXE was not found:
+  echo %EXE%
+  pause
+  exit /b 20
+)
+
+echo.
+echo [SUCCESS] Final EXE created and verified.
+echo Launching ALBAZ Lunar Eclipse Atlas...
+start "" "%EXE%"
+exit /b 0
