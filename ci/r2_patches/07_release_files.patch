+  echo.
+  pause
+  exit /b 2
)
+
+echo [OK] Python: %PYBASE%
+set "ENVROOT=%LOCALAPPDATA%\ALBAZ_ASTROTECH\LUNAR_RUN_ENV"
+set "VENV=%ENVROOT%\venv"
+set "PY=%VENV%\Scripts\python.exe"
+
+if not exist "%PY%" (
