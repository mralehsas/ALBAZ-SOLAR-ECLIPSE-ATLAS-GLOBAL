@@ -0,0 +1,32 @@
+@echo off
+setlocal EnableExtensions
+chcp 65001 >nul
+cd /d "%~dp0"
+title ALBAZ Lunar Eclipse Atlas - Prepare Global Cities
+
+echo ============================================================
+echo  ALBAZ LUNAR ECLIPSE ATLAS v9.6.3 TESLA FINAL
+echo  OFFLINE WORLD CITIES DATABASE PREPARATION
+echo ============================================================
+
+set "PYEXE="
+if defined LUNAR_PYTHON if exist "%LUNAR_PYTHON%" set "PYEXE=%LUNAR_PYTHON%"
+if not defined PYEXE for /f "delims=" %%P in ('py -3.11 -c "import sys; assert sys.maxsize ^> 2**32; print(sys.executable)" 2^>nul') do set "PYEXE=%%P"
+if not defined PYEXE (
+  echo [ERROR] Python 3.11 x64 was not found.
+  exit /b 2
+)
+
+set "CACHE=%LOCALAPPDATA%\ALBAZ_ASTROTECH\LUNAR_GEONAMES"
+if not exist "%CACHE%" mkdir "%CACHE%"
+
+echo [1/2] Preparing official GeoNames cities500 data...
+"%PYEXE%" scripts\fetch_geonames_lunar.py --cache-dir "%CACHE%" --output "data\world_cities.sqlite3"
+if errorlevel 1 exit /b 3
+
+echo [2/2] Running lunar source preflight...
+"%PYEXE%" lunar_release_preflight.py --root "%CD%" --min-cities 100000
+if errorlevel 1 exit /b 4
+
+echo SUCCESS - data\world_cities.sqlite3 is ready.
+exit /b 0
