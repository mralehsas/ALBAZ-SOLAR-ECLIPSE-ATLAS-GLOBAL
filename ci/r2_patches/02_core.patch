+def jd_to_calendar_components(jd: float, *, calendar: str = "gregorian") -> tuple[int, int, int, int, int, float]:
+    """Convert JD to civil components in the requested proleptic calendar.
+
+    This is a calendar-label conversion only; the astronomical instant is
+    unchanged.  `calendar` must be ``gregorian`` or ``julian``.
+    """
+    cal = str(calendar).strip().lower()
+    if cal not in {"gregorian", "julian"}:
+        raise ValueError("calendar must be 'gregorian' or 'julian'")
+    x = float(jd) + 0.5
+    z = int(x // 1)
+    f = x - z
+    if cal == "gregorian":
+        alpha = int((z - 1867216.25) / 36524.25)
+        a = z + 1 + alpha - alpha // 4
+    else:
+        a = z
+    b = a + 1524
+    c = int((b - 122.1) / 365.25)
+    d = int(365.25 * c)
+    e = int((b - d) / 30.6001)
+    day_float = b - d - int(30.6001 * e) + f
+    day = int(day_float)
+    frac_day = day_float - day
+    month = e - 1 if e < 14 else e - 13
+    year = c - 4716 if month > 2 else c - 4715
+
+    total_seconds = frac_day * SECONDS_PER_DAY
+    hour = int(total_seconds // 3600.0)
+    total_seconds -= hour * 3600.0
+    minute = int(total_seconds // 60.0)
+    second = total_seconds - minute * 60.0
+    # Floating-point JD arithmetic can produce 59.99999/60.00000 around exact
+    # civil seconds. Normalize tiny overflows without changing the date.
+    if second >= 59.9999995:
+        second = 60.0
+    return int(year), int(month), int(day), hour, minute, float(second)
+
