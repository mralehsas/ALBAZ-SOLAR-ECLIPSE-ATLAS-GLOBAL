+def _modern_utc_datetime(utc_jd: float) -> datetime:
+    """Convert a certified modern UTC JD to an aware datetime.
+
+    This helper is intentionally limited to the era where this atlas actually
+    supplies UTC (1972..2026).  It is never used to fabricate historical UTC.
+    """
