+def historical_calendar_components(jd: float) -> tuple[int, int, int, int, int, float, str]:
+    """NASA-style historical civil label: Julian before 1582-10-15, Gregorian after."""
+    if float(jd) < GREGORIAN_REFORM_JD:
+        return (*jd_to_calendar_components(jd, calendar="julian"), "Julian")
+    return (*jd_to_calendar_components(jd, calendar="gregorian"), "Gregorian")
+
