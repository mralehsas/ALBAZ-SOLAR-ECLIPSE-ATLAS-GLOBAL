+def format_jd_label(jd: float | None, scale: str, *, historical: bool = True) -> str:
+    """Format a Julian Date at whole-second precision without calendar ambiguity.
+
+    Before the Gregorian reform the default historical label follows the same
+    Julian-calendar convention used by the NASA eclipse catalogs.  Modern
+    labels remain uncluttered because Gregorian is unambiguous there.
+    """
+    if jd is None:
+        return "—"
+    rounded_jd = float(jd) + 0.5 / SECONDS_PER_DAY
+    if historical:
+        year, month, day, hour, minute, second, calendar = historical_calendar_components(rounded_jd)
+    else:
+        year, month, day, hour, minute, second = jd_to_calendar_components(rounded_jd, calendar="gregorian")
+        calendar = "Gregorian"
+    whole_second = int(second)
+    label = f"{year:04d}-{month:02d}-{day:02d} {hour:02d}:{minute:02d}:{whole_second:02d} {str(scale).strip()}"
+    if historical and calendar == "Julian":
+        label += " [Julian]"
+    return label
+
